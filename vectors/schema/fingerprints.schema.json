{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wolfware-labs/pavia/vectors/schema/fingerprints.schema.json",
  "title": "Pavia contract fingerprint vectors",
  "type": "object",
  "required": ["group", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "group": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "note": {"type": "string"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "spec": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)*|Appendix [A-Z])$"}
    },
    "case": {
      "type": "object",
      "required": ["id", "spec", "note", "manifest"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "spec": {"$ref": "#/$defs/spec"},
        "note": {"type": "string", "minLength": 1},
        "manifest": {},
        "canonical": {"type": "string", "minLength": 2},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "error": {"enum": ["null", "default", "unsorted", "not_an_array", "not_an_object", "not_a_double"]}
      },
      "oneOf": [
        {"required": ["canonical", "fingerprint"], "not": {"required": ["error"]}},
        {"required": ["error"], "not": {"anyOf": [{"required": ["canonical"]}, {"required": ["fingerprint"]}]}}
      ]
    }
  }
}
