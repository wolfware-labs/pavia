{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wolfware-labs/pavia/vectors/schema/headers.schema.json",
  "title": "Pavia header section vectors",
  "type": "object",
  "required": ["group", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "group": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "note": {"type": "string"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "spec": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)*|Appendix [A-Z])$"}
    },
    "hex": {"type": "string", "pattern": "^[0-9a-f]{2}( ?[0-9a-f]{2})*$"},
    "case": {
      "type": "object",
      "required": ["id", "spec", "note", "direction", "hex"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "spec": {"$ref": "#/$defs/spec"},
        "note": {"type": "string", "minLength": 1},
        "direction": {"enum": ["both", "decode"]},
        "hex": {"$ref": "#/$defs/hex"},
        "header": {"type": "string", "minLength": 1},
        "max_size": {"type": "integer", "minimum": 1},
        "max_depth": {"type": "integer", "minimum": 1},
        "error": {"enum": ["not_a_map", "trailing_bytes", "malformed", "indefinite_length", "tag", "duplicate_key", "too_deep", "too_large"]}
      },
      "oneOf": [
        {"required": ["header"], "not": {"required": ["error"]}},
        {"required": ["error"], "not": {"required": ["header"]}, "properties": {"direction": {"const": "decode"}}}
      ]
    }
  }
}
