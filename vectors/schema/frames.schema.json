{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wolfware-labs/pavia/vectors/schema/frames.schema.json",
  "title": "Pavia frame vectors",
  "type": "object",
  "required": ["group", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "group": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "note": {"type": "string"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "spec": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)*|Appendix [A-Z])$"}
    },
    "hex": {"type": "string", "pattern": "^[0-9a-f]{2}( ?[0-9a-f]{2})*$"},
    "closeCode": {
      "enum": [
        "NORMAL", "PROTOCOL_ERROR", "UNSUPPORTED_VERSION", "UNAUTHENTICATED", "FORBIDDEN",
        "IDLE_TIMEOUT", "SLOW_CONSUMER", "GOING_AWAY", "INTERNAL", "FRAME_TOO_LARGE",
        "LIMIT_EXCEEDED", "RESUME_FAILED", "HANDSHAKE_TIMEOUT", "CONTRACT_MISMATCH"
      ]
    },
    "frame": {
      "type": "object",
      "required": ["type", "flags", "header", "data"],
      "additionalProperties": false,
      "properties": {
        "stream": {"type": "integer", "minimum": 0},
        "type": {"type": "integer", "minimum": 0, "maximum": 255},
        "name": {"type": "string", "pattern": "^[A-Z_]+$"},
        "flags": {"type": "integer", "minimum": 0, "maximum": 255},
        "header": {"type": ["string", "null"]},
        "data": {"type": ["string", "null"]},
        "data_hex": {"type": "string", "pattern": "^([0-9a-f]{2}( ?[0-9a-f]{2})*)?$"},
        "codec": {"enum": ["cbor", "json"]}
      },
      "allOf": [
        {
          "if": {"properties": {"data": {"type": "string"}}, "required": ["data"]},
          "then": {"required": ["codec"]}
        }
      ]
    },
    "case": {
      "type": "object",
      "required": ["id", "spec", "note", "binding", "direction", "hex"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "spec": {"$ref": "#/$defs/spec"},
        "note": {"type": "string", "minLength": 1},
        "binding": {"enum": ["ws", "wt"]},
        "direction": {"enum": ["both", "decode"]},
        "hex": {"$ref": "#/$defs/hex"},
        "fin": {"type": "boolean"},
        "frames": {"type": "array", "items": {"$ref": "#/$defs/frame"}},
        "error": {
          "type": "object",
          "required": ["code"],
          "additionalProperties": false,
          "properties": {
            "code": {"$ref": "#/$defs/closeCode"},
            "reason": {"type": "string"}
          }
        }
      },
      "oneOf": [
        {"required": ["frames"], "not": {"required": ["error"]}},
        {"required": ["error"], "not": {"required": ["frames"]}, "properties": {"direction": {"const": "decode"}}}
      ],
      "allOf": [
        {
          "if": {"properties": {"binding": {"const": "ws"}}},
          "then": {
            "not": {"required": ["fin"]},
            "properties": {"frames": {"items": {"required": ["stream"]}}}
          },
          "else": {"properties": {"frames": {"items": {"not": {"required": ["stream"]}}}}}
        }
      ]
    }
  }
}
