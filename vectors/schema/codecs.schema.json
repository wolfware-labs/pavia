{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wolfware-labs/pavia/vectors/schema/codecs.schema.json",
  "title": "Pavia codec vectors",
  "type": "object",
  "required": ["group", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "group": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "note": {"type": "string"},
    "types": {
      "description": "Named types referenced with {\"ref\": ...}, in the form of the manifest `types` object (spec 12.2).",
      "type": "object"
    },
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "spec": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)*|Appendix [A-Z])$"}
    },
    "hex": {"type": "string", "pattern": "^[0-9a-f]{2}( ?[0-9a-f]{2})*$"},
    "type": {
      "description": "A contract type in manifest syntax (spec 12.2): a primitive name or an object such as {\"list\": ...}, {\"option\": ...}, {\"ref\": ...}.",
      "type": ["string", "object"]
    },
    "case": {
      "type": "object",
      "required": ["id", "spec", "note", "type", "direction"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "spec": {"$ref": "#/$defs/spec"},
        "note": {"type": "string", "minLength": 1},
        "type": {"$ref": "#/$defs/type"},
        "direction": {"enum": ["both", "decode"]},
        "value": {"type": "string", "minLength": 1},
        "cbor": {"$ref": "#/$defs/hex"},
        "json": {"type": "string"},
        "error": {
          "type": "object",
          "required": ["codec"],
          "additionalProperties": false,
          "properties": {
            "codec": {"enum": ["cbor", "json"]},
            "reason": {"type": "string"}
          }
        }
      },
      "oneOf": [
        {"required": ["value"], "anyOf": [{"required": ["cbor"]}, {"required": ["json"]}], "not": {"required": ["error"]}},
        {"required": ["error"], "not": {"required": ["value"]}, "properties": {"direction": {"const": "decode"}}}
      ]
    }
  }
}
