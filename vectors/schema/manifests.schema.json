{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wolfware-labs/pavia/vectors/schema/manifests.schema.json",
  "title": "Pavia manifest reading vectors",
  "type": "object",
  "required": [
    "group",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "group": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "note": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "spec": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^([0-9]+(\\.[0-9]+)*|Appendix [A-Z])$"
      }
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "spec",
        "note",
        "manifest"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "spec": {
          "$ref": "#/$defs/spec"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "object"
        },
        "error": {
          "enum": [
            "too_deep",
            "name_too_long"
          ]
        }
      }
    }
  }
}
